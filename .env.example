# Copy this file to .env and fill in the keys for providers you use.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
# Optional OpenCode-compatible base URL; the default is OpenCode Console's OpenAI chat-completions endpoint.
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Optional comma-separated dropdown overrides. If omitted, app.py's DEFAULT_MODELS are used.
GEMINI_MODELS=
OPENROUTER_MODELS=
OPENCODE_MODELS=
# Optional preselected OpenCode model; it is added to the dropdown if absent from OPENCODE_MODELS.
OPENCODE_MODEL=
